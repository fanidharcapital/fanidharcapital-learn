---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SITE from "@/config";

const pillars = [
  {
    title: "Structured 365-Day Roadmap",
    detail:
      "Twelve progressive modules take learners from market basics and T+1 settlement through fundamental analysis, charts, derivatives, risk discipline, and case studies.",
  },
  {
    title: "Visual-First Lessons",
    detail:
      "Each daily entry pairs a clear graphic or diagram with concise markdown notes so complex market mechanics stay easy to review on mobile or desktop.",
  },
  {
    title: "Indian Market Context",
    detail:
      "Explanations center on how Indian equity and derivatives markets operate in practice—exchanges, clearing, order types, risk limits, and market structure.",
  },
  {
    title: "Education Over Hype",
    detail:
      "Designed to build lasting conceptual clarity and independent thinking rather than shortcuts, tips, or sensational trading calls.",
  },
];
---

<Layout title={`About | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout pb-14">
    <Breadcrumb />

    <section class="relative isolate overflow-hidden rounded-3xl border border-[#c9a45a]/35 bg-[#0c3024] px-6 py-10 text-[#f8f3e8] shadow-sm sm:px-10 sm:py-12">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-14 -top-16 h-64 w-64 rounded-full border border-[#c9a45a]/25"
      />
      <div class="relative max-w-3xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">
          About the Academy
        </p>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
          Shree Fanidhar Capital Learning Series
        </h1>
        <p class="mt-4 text-base leading-7 text-[#e5ece7] sm:text-lg">
          A dedicated educational portal for structured financial market learning—built to help readers understand how markets work, step by step, through visual lessons and practical notes.
        </p>
      </div>
    </section>

    <section class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        pillars.map(pillar => (
          <div class="rounded-2xl border border-border bg-background p-6">
            <h2 class="text-lg font-semibold tracking-tight">{pillar.title}</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {pillar.detail}
            </p>
          </div>
        ))
      }
    </section>

    <section class="mt-10 rounded-2xl border border-border bg-muted/30 p-6 sm:p-8">
      <h2 class="text-xl font-semibold tracking-tight">How to Use This Portal</h2>
      <ol class="mt-4 list-decimal space-y-2.5 pl-5 text-sm leading-6 text-muted-foreground">
        <li>
          Start with <a href="/posts/" class="font-semibold text-accent underline underline-offset-4">Posts</a> to read published daily lessons in sequence or browse the latest notes.
        </li>
        <li>
          Explore <a href="/curriculum/" class="font-semibold text-accent underline underline-offset-4">Curriculum</a> to see how all 365 days map across the 12 learning modules.
        </li>
        <li>
          Filter by topic or day using <a href="/tags/" class="font-semibold text-accent underline underline-offset-4">Tags</a> whenever you want to revisit a specific concept.
        </li>
      </ol>
    </section>

    <section class="mt-8 rounded-2xl border border-[#c9a45a]/40 bg-[#f5f0e4] p-6 text-[#23382d] sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#80632b]">
        Educational Disclaimer
      </p>
      <h2 class="mt-2 text-xl font-semibold">Knowledge first. Decisions remain yours.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6">
        Content published on this learning portal is strictly for educational and informational purposes. Nothing here constitutes investment advice, research recommendations, or a guarantee of future market performance. Always evaluate concepts independently and consider your own circumstances before making financial decisions.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
