---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { FINAL_EXAM_CONFIG, FINAL_EXAM_QUESTIONS } from "@/data/finalExam";
import type { QuizQuestion } from "@/data/moduleQuizzes";

const examJson = JSON.stringify({
  passingScore: FINAL_EXAM_CONFIG.passingScore,
  storageKey: FINAL_EXAM_CONFIG.storageKey,
  questions: FINAL_EXAM_QUESTIONS,
});
---

<Layout title={`${FINAL_EXAM_CONFIG.title} | Shree Fanidhar Capital`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-4xl px-4 pb-16 pt-8 sm:px-6">
    <a
      href="/curriculum/"
      class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-[#9c7016] hover:underline"
    >
      ← Back to 365-Day Curriculum
    </a>

    <section
      id="final-exam-section"
      class="mt-5 rounded-3xl border-2 border-[#10201a] bg-white p-5 shadow-[0_4px_0_#10201a] sm:p-8"
      data-exam={examJson}
    >
      <div class="flex flex-col justify-between gap-3 border-b-2 border-[#10201a]/15 pb-5 sm:flex-row sm:items-center">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#9c7016]">
            CAPSTONE ASSESSMENT · {FINAL_EXAM_QUESTIONS.length} QUESTIONS · PASS: {FINAL_EXAM_CONFIG.passingScore}/{FINAL_EXAM_QUESTIONS.length}
          </p>
          <h1 class="mt-1 text-2xl font-bold tracking-tight text-[#10201a] sm:text-3xl">
            {FINAL_EXAM_CONFIG.title}
          </h1>
          <p class="mt-1.5 text-sm text-[#4b5d52]">
            Comprehensive checkpoint spanning Modules 01–12: market structure, fundamentals, price action, F&amp;O, Greeks, risk, and macro.
          </p>
        </div>
        <span
          id="exam-saved-badge"
          class="hidden self-start rounded-full border-2 border-[#10201a] bg-[#08241b] px-3.5 py-1.5 font-mono text-xs font-semibold text-[#d8bd7b] sm:self-auto"
        ></span>
      </div>

      <form id="final-exam-form" class="mt-6 space-y-6">
        {FINAL_EXAM_QUESTIONS.map((q: QuizQuestion, qIdx: number) => (
          <fieldset
            class="exam-question-card rounded-2xl border-2 border-[#10201a] bg-[#faf8f3] p-4 sm:p-5"
            data-question-index={qIdx}
          >
            <legend class="px-1 font-mono text-xs font-bold uppercase tracking-wider text-[#4b5d52]">
              Question {qIdx + 1} of {FINAL_EXAM_QUESTIONS.length}
            </legend>
            <p class="mt-1 text-base font-bold leading-snug text-[#10201a]">
              {q.question}
            </p>

            <div class="mt-3.5 space-y-2.5">
              {q.options.map((opt: string, optIdx: number) => (
                <label class="exam-option flex cursor-pointer items-start gap-3 rounded-xl border-2 border-[#10201a]/25 bg-white px-3.5 py-2.5 text-sm font-medium text-[#10201a] transition hover:border-[#10201a]">
                  <input
                    type="radio"
                    name={`exam-q-${qIdx}`}
                    value={optIdx}
                    class="mt-0.5 size-4 shrink-0 accent-[#08241b]"
                  />
                  <span>{opt}</span>
                </label>
              ))}
            </div>

            <p class="exam-explanation mt-3 hidden rounded-xl border border-[#10201a]/20 bg-white px-3.5 py-2.5 text-xs leading-5 text-[#2d3e35]"></p>
          </fieldset>
        ))}

        <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-3 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
            >
              Submit Final Exam
            </button>
            <button
              type="button"
              id="exam-reset-btn"
              class="hidden min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#10201a] bg-white px-5 py-3 text-sm font-semibold text-[#10201a] transition hover:bg-[#faf8f3]"
            >
              Retake Exam
            </button>
          </div>

          <div
            id="exam-result-box"
            class="hidden rounded-xl border-2 border-[#10201a] bg-[#08241b] px-4 py-2.5 text-sm font-semibold text-[#f8f3e8]"
            aria-live="polite"
          ></div>
        </div>
      </form>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initFinalExam() {
    const section = document.getElementById("final-exam-section");
    if (!section) return;

    const rawData = section.getAttribute("data-exam");
    if (!rawData) return;

    const exam = JSON.parse(rawData);
    const form = document.getElementById("final-exam-form") as HTMLFormElement | null;
    const resetBtn = document.getElementById("exam-reset-btn");
    const resultBox = document.getElementById("exam-result-box");
    const savedBadge = document.getElementById("exam-saved-badge");

    if (!form || !resetBtn || !resultBox || !savedBadge) return;

    const updateBadge = (score: number) => {
      const passed = score >= exam.passingScore;
      savedBadge.textContent = `${passed ? "✓ Certified" : "Best Score"}: ${score} / ${exam.questions.length}`;
      savedBadge.classList.remove("hidden");
    };

    const existing = localStorage.getItem(exam.storageKey);
    if (existing !== null) {
      updateBadge(Number(existing));
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      let score = 0;

      exam.questions.forEach((q: any, qIdx: number) => {
        const card = form.querySelector(`[data-question-index="${qIdx}"]`);
        if (!card) return;

        const selected = form.querySelector(`input[name="exam-q-${qIdx}"]:checked`) as HTMLInputElement | null;
        const chosenIdx = selected ? Number(selected.value) : -1;
        const optionLabels = card.querySelectorAll(".exam-option");
        const explanationEl = card.querySelector(".exam-explanation");

        optionLabels.forEach((label, optIdx) => {
          label.classList.remove("border-emerald-700", "bg-emerald-50", "border-red-700", "bg-red-50");
          if (optIdx === q.correctIndex) {
            label.classList.add("border-emerald-700", "bg-emerald-50");
          } else if (optIdx === chosenIdx && chosenIdx !== q.correctIndex) {
            label.classList.add("border-red-700", "bg-red-50");
          }
        });

        if (chosenIdx === q.correctIndex) {
          score += 1;
        }

        if (explanationEl) {
          explanationEl.textContent = `${chosenIdx === q.correctIndex ? "Correct:" : "Explanation:"} ${q.explanation}`;
          explanationEl.classList.remove("hidden");
        }
      });

      const passed = score >= exam.passingScore;
      resultBox.textContent = passed
        ? `Final Score: ${score} / ${exam.questions.length} — Capstone Assessment Passed!`
        : `Final Score: ${score} / ${exam.questions.length} — Need ${exam.passingScore}/${exam.questions.length} to pass. Review explanations above and retry.`;
      resultBox.classList.remove("hidden");
      resetBtn.classList.remove("hidden");

      const prevBest = Number(localStorage.getItem(exam.storageKey) ?? -1);
      if (score > prevBest) {
        localStorage.setItem(exam.storageKey, String(score));
      }
      updateBadge(Math.max(score, prevBest));
    });

    resetBtn.addEventListener("click", () => {
      form.reset();
      resultBox.classList.add("hidden");
      resetBtn.classList.add("hidden");
      form.querySelectorAll(".exam-option").forEach((label) => {
        label.classList.remove("border-emerald-700", "bg-emerald-50", "border-red-700", "bg-red-50");
      });
      form.querySelectorAll(".exam-explanation").forEach((el) => {
        el.classList.add("hidden");
      });
    });
  }

  initFinalExam();
  document.addEventListener("astro:after-swap", initFinalExam);
</script>
