---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import SITE from "@/config";

const posts = getSortedPosts(await getCollection("posts", ({ data }) => !data.draft));
const learningPath = [
  { range: "01–30", title: "Market foundations", detail: "Shares, indices, market participants, and order types." },
  { range: "31–60", title: "Exchanges & operations", detail: "Trading sessions, clearing, settlement, and market infrastructure." },
  { range: "61–90", title: "Fundamental analysis", detail: "Businesses, financial statements, valuation, and key ratios." },
  { range: "91–120", title: "Technical analysis", detail: "Charts, trends, support and resistance, and indicators." },
  { range: "121–150", title: "Price action", detail: "Candles, market structure, and context." },
  { range: "151–180", title: "Futures market", detail: "Contracts, margin, expiry, basis, and futures risk." },
  { range: "181–210", title: "Options market", detail: "Calls, puts, payoff profiles, and option-chain terminology." },
  { range: "211–240", title: "Greeks & strategies", detail: "Sensitivity measures and multi-leg position behaviour." },
  { range: "241–270", title: "Risk & psychology", detail: "Position sizing, risk limits, discipline, and decision-making." },
  { range: "271–300", title: "Institutions & macro", detail: "Economic data, global cues, and institutional activity." },
  { range: "301–330", title: "Advanced concepts", detail: "Market structure, volatility, and advanced frameworks." },
  { range: "331–365", title: "Case studies", detail: "Educational examples, application, and review exercises." },
];
---

<Layout title={`Learning Curriculum | ${SITE.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="rounded-3xl border border-border bg-[#0c3024] px-6 py-10 text-[#f8f3e8] sm:px-10 sm:py-14">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">Shree Fanidhar Capital · Learning</p>
      <h1 class="max-w-3xl text-3xl font-semibold leading-tight sm:text-5xl">The learning curriculum</h1>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-[#e5ece7] sm:text-base">A public, self-paced roadmap through Indian markets, analysis, derivatives, and risk. Read published lessons freely; the full series will be added progressively.</p>
      <a href="#published-lessons" class="mt-7 inline-flex min-h-11 items-center rounded-full bg-[#d8bd7b] px-5 py-3 text-sm font-semibold text-[#173426]">Explore published lessons <span aria-hidden="true" class="ml-2">↓</span></a>
    </section>

    <section class="py-12 sm:py-16">
      <div class="mb-7 max-w-2xl">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">365-day roadmap</p>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Learn in stages</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Modules provide a suggested sequence, not a deadline. Move at a pace that supports understanding.</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {learningPath.map((module, index) => (
          <li id={`module-${index + 1}`} class="scroll-mt-24 rounded-2xl border border-border bg-background p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Module {String(index + 1).padStart(2, "0")}</span>
              <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">Days {module.range}</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold">{module.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{module.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="published-lessons" class="border-t border-border py-12 sm:py-16">
      <div class="mb-6">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">Available now</p>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Published lessons</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">Open any lesson below. New lessons will appear here as they are published.</p>
      </div>
      {posts.length > 0 ? (
        <ul class="grid gap-5 md:grid-cols-2">
          {posts.map(post => <Card variant="h3" {...post} />)}
        </ul>
      ) : (
        <p class="rounded-2xl border border-border p-6 text-sm text-muted-foreground">Lessons are being prepared. Please check back soon.</p>
      )}
    </section>
    <p class="mb-12 rounded-2xl border border-[#c9a45a]/40 bg-[#f5f0e4] p-6 text-sm leading-6 text-[#23382d]">Educational content only. This curriculum is not investment advice, a recommendation to buy or sell securities, or a promise of market outcomes.</p>
  </main>
  <Footer />
</Layout>
