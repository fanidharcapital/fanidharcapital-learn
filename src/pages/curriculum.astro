---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { FINAL_EXAM_CONFIG, FINAL_EXAM_QUESTIONS } from "@/data/finalExam";
import SITE from "@/config";

function isOverviewPost(post: any): boolean {
  const title = (post.data.title ?? "").toLowerCase();
  const idOrSlug = `${post.id ?? ""} ${post.slug ?? ""}`.toLowerCase();
  return title.includes("overview") || idOrSlug.includes("overview");
}

function getLessonNumber(post: any): number {
  if (isOverviewPost(post)) return 9999;

  const slugOrId = `${post.slug ?? ""} ${post.id ?? ""}`;
  const slugMatch = slugOrId.match(/education-series-(\d+)/i);
  if (slugMatch) return Number(slugMatch[1]);

  const titleMatch =
    post.data.title?.match(/education(?:al)?\s+series\s*#?(\d+)/i) ||
    post.data.title?.match(/#(\d+)/);
  if (titleMatch) return Number(titleMatch[1]);

  return 9999;
}

const posts = await getCollection("posts", ({ data }) => !data.draft);

const learningPath = [
  { week: 1, number: 1, min: 1, max: 30, title: "Market foundations", detail: "Shares, indices, market participants, and order types." },
  { week: 2, number: 2, min: 31, max: 60, title: "Exchanges & operations", detail: "Trading sessions, clearing, settlement, and market infrastructure." },
  { week: 3, number: 3, min: 61, max: 90, title: "Fundamental analysis", detail: "Businesses, financial statements, valuation, and key ratios." },
  { week: 4, number: 4, min: 91, max: 120, title: "Technical analysis", detail: "Charts, trends, support and resistance, and indicators." },
  { week: 5, number: 5, min: 121, max: 150, title: "Price action", detail: "Candles, market structure, and context." },
  { week: 6, number: 6, min: 151, max: 180, title: "Futures market", detail: "Contracts, margin, expiry, basis, and futures risk." },
  { week: 7, number: 7, min: 181, max: 210, title: "Options market", detail: "Calls, puts, payoff profiles, and option-chain terminology." },
  { week: 8, number: 8, min: 211, max: 240, title: "Greeks & strategies", detail: "Sensitivity measures and multi-leg position behaviour." },
  { week: 9, number: 9, min: 241, max: 270, title: "Risk & psychology", detail: "Position sizing, risk limits, discipline, and decision-making." },
  { week: 10, number: 10, min: 271, max: 300, title: "Institutions & macro", detail: "Economic data, global cues, and institutional activity." },
  { week: 11, number: 11, min: 301, max: 330, title: "Advanced concepts", detail: "Market structure, volatility, and advanced frameworks." },
  { week: 12, number: 12, min: 331, max: 365, title: "Case studies", detail: "Educational examples, application, and review exercises." },
  { week: 13, number: 13, min: 366, max: 375, title: "Asset allocation & execution", detail: "Asset class comparisons, taxation, capital buckets, execution playbooks, and hedging." },
];
---

<Layout title={`13-Week Learning Curriculum | ${SITE.site.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <section class="rounded-3xl border-2 border-[#10201a] bg-[#0c3024] px-6 py-10 text-[#f8f3e8] shadow-[0_4px_0_#10201a] sm:px-10 sm:py-14">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">Shree Fanidhar Capital · 13-Week Track</p>
      <h1 class="max-w-3xl text-3xl font-semibold leading-tight sm:text-5xl">The 13-week learning curriculum</h1>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-[#e5ece7] sm:text-base">One module per week across 13 weeks—covering Indian markets, analysis, derivatives, asset allocation, and execution—followed by the final certification quiz in Week 14.</p>
      <a href="#roadmap" class="mt-7 inline-flex min-h-11 items-center rounded-full bg-[#d8bd7b] px-5 py-3 text-sm font-semibold text-[#173426]">
        Explore 13 weeks + Final Quiz <span aria-hidden="true" class="ml-2">↓</span>
      </a>
    </section>

    <section id="roadmap" class="scroll-mt-24 py-12 sm:py-16">
      <div class="mb-7 max-w-2xl">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent">13-week roadmap · 1 module per week</p>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Learn week by week</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Module 01 is for Week 01, Module 02 is for Week 02, through Module 13 for Week 13—followed by the 20-question final quiz in Week 14.</p>
      </div>

      <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {learningPath.map((module) => {
          const count = posts.filter((p) => {
            const n = getLessonNumber(p);
            return n >= module.min && n <= module.max;
          }).length;
          const modSlug = `module-${String(module.number).padStart(2, "0")}`;
          const weekLabel = `Week ${String(module.week).padStart(2, "0")}`;

          return (
            <li class="scroll-mt-24">
              <a
                href={`/modules/${modSlug}/`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full w-full flex-col rounded-2xl border-2 border-[#10201a] bg-background p-5 text-left shadow-[0_3px_0_#10201a] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_5px_0_#10201a] focus:outline-none focus:ring-2 focus:ring-accent"
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
                    {weekLabel} · Module {String(module.number).padStart(2, "0")}
                  </span>
                  <span class="rounded-full border border-[#10201a]/25 bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
                    1 Week · {count} {count === 1 ? "lesson" : "lessons"}
                  </span>
                </div>
                <h3 class="mt-4 text-lg font-semibold group-hover:text-accent">{module.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{module.detail}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent">Explore {weekLabel.toLowerCase()} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span></span>
              </a>
            </li>
          );
        })}

        <li class="scroll-mt-24">
          <a
            href="/modules/module-14/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex h-full w-full flex-col rounded-2xl border-2 border-[#10201a] bg-[#0c3024] p-5 text-left text-[#f8f3e8] shadow-[0_3px_0_#10201a] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_5px_0_#10201a] focus:outline-none focus:ring-2 focus:ring-accent"
          >
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[#d8bd7b]">
                Week 14 · Module 14 Quiz
              </span>
              <span class="rounded-full border border-[#d8bd7b]/40 bg-[#10201a] px-3 py-1 text-xs font-medium text-[#d8bd7b]">
                {FINAL_EXAM_QUESTIONS.length} Questions · Pass {FINAL_EXAM_CONFIG.passingScore}/{FINAL_EXAM_QUESTIONS.length}
              </span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-white group-hover:text-[#d8bd7b]">
              {FINAL_EXAM_CONFIG.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-[#e5ece7]">
              Cumulative 20-question final certification assessment across all 13 weekly modules with instant answers and explanations.
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#d8bd7b]">
              Start final quiz <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
            </span>
          </a>
        </li>
      </ol>
    </section>

    <p class="mb-12 rounded-2xl border-2 border-[#10201a] bg-[#f5f0e4] p-6 text-sm leading-6 text-[#23382d] shadow-[0_3px_0_#10201a]">
      Educational content only. This curriculum is not investment advice, a recommendation to buy or sell securities, or a promise of market outcomes.
    </p>
  </main>
  <Footer />
</Layout>
