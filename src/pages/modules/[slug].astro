---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ModuleQuiz from "@/components/ModuleQuiz.astro";
import { MODULE_QUIZZES } from "@/data/moduleQuizzes";
import "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const moduleSlugs = Array.from(
    new Set(
      posts
        .map((post) => {
          const slug = post.id.toLowerCase();
          const match = slug.match(/module[-_\s]?0?([1-9]|1[0-2])/i);
          if (match) {
            return `module-${match[1].padStart(2, "0")}`;
          }
          return null;
        })
        .filter((s): s is string => Boolean(s))
    )
  );

  for (let i = 1; i <= 12; i++) {
    const slug = `module-${String(i).padStart(2, "0")}`;
    if (!moduleSlugs.includes(slug)) {
      moduleSlugs.push(slug);
    }
  }

  moduleSlugs.sort();

  return moduleSlugs.map((slug) => {
    const quiz = MODULE_QUIZZES[slug];
    return {
      params: { slug },
      props: {
        slug,
        title: quiz?.moduleTitle ?? slug.replace("-", " ").toUpperCase(),
        quiz,
      },
    };
  });
}

const { slug, title, quiz } = Astro.props;
const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const modulePosts = allPosts
  .filter((post) => {
    const combined = `${post.id} ${post.data.title} ${(post.data.tags ?? []).join(" ")}`.toLowerCase();
    const num = slug.replace("module-", "");
    const unpadded = String(Number(num));
    return (
      combined.includes(`module-${num}`) ||
      combined.includes(`module ${num}`) ||
      combined.includes(`module ${unpadded}`) ||
      combined.includes(`module-${unpadded}`)
    );
  })
  .sort((a, b) => a.data.pubDatetime.valueOf() - b.data.pubDatetime.valueOf());

const currentNum = Number(slug.replace("module-", ""));
const prevSlug = currentNum > 1 ? `module-${String(currentNum - 1).padStart(2, "0")}` : null;
const nextSlug = currentNum < 12 ? `module-${String(currentNum + 1).padStart(2, "0")}` : null;
const isLastModule = currentNum === 12;
---

<Layout title={`${title} | Shree Fanidhar Capital`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-4xl px-4 pb-16 pt-8 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a
        href="/curriculum/"
        class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#10201a] bg-white px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-[#9c7016] transition hover:bg-[#faf8f3]"
      >
        ← Back to 365-Day Curriculum
      </a>
      <span class="rounded-full border-2 border-[#10201a] bg-[#faf8f3] px-4 py-1.5 font-mono text-xs font-semibold uppercase text-[#4b5d52]">
        {slug.replace("-", " ")}
      </span>
    </div>

    <header class="mt-5 rounded-3xl border-2 border-[#10201a] bg-[#08241b] p-6 text-[#f8f3e8] shadow-[0_4px_0_#10201a] sm:p-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#d8bd7b]">
        SHREE FANIDHAR CAPITAL · {slug.replace("-", " ").toUpperCase()}
      </p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
        {title}
      </h1>
      <p class="mt-2 text-sm text-[#f8f3e8]/85">
        {modulePosts.length} published lessons in this chapter. Read in sequence and complete the module checkpoint quiz below.
      </p>
    </header>

    <section class="mt-8">
      <h2 class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-[#9c7016]">
        CHAPTER LESSONS
      </h2>
      {modulePosts.length > 0 ? (
        <ul class="mt-4 space-y-3">
          {modulePosts.map((post, idx) => (
            <li>
              <a
                href={`/posts/${post.id}/`}
                class="flex items-center justify-between gap-4 rounded-full border-2 border-[#10201a] bg-white px-5 py-3.5 text-[#10201a] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
              >
                <span class="truncate text-sm font-semibold sm:text-base">
                  <span class="mr-2.5 font-mono text-xs text-[#9c7016]">{String(idx + 1).padStart(2, "0")}.</span>
                  {post.data.title}
                </span>
                <span class="shrink-0 rounded-full bg-[#faf8f3] px-3 py-1 font-mono text-xs font-semibold text-[#9c7016]">
                  Read →
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 rounded-3xl border-2 border-[#10201a] bg-[#faf8f3] p-4 text-sm text-[#4b5d52]">
          Lessons for this chapter are being published progressively across the 365-day roadmap. You can still practice the module quiz below.
        </p>
      )}
    </section>

    {quiz && <ModuleQuiz quiz={quiz} />}

    <nav aria-label="Chapter navigation" class="mt-8 flex flex-wrap items-center justify-between gap-3">
      {prevSlug ? (
        <a
          href={`/modules/${prevSlug}/`}
          class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#10201a] bg-white px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-[#10201a] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
        >
          ← {prevSlug.replace("-", " ")}
        </a>
      ) : (
        <span />
      )}

      {nextSlug && (
        <a
          href={`/modules/${nextSlug}/`}
          class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#10201a] bg-[#08241b] px-6 py-2.5 font-mono text-xs font-semibold uppercase tracking-wider text-[#d8bd7b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
        >
          Next: {nextSlug.replace("-", " ")} →
        </a>
      )}
    </nav>

    {isLastModule && (
      <div class="mt-10 rounded-3xl border-2 border-[#10201a] bg-[#08241b] p-6 text-[#f8f3e8] shadow-[0_4px_0_#10201a]">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#d8bd7b]">
          FINAL STEP · 20-QUESTION EXAM
        </p>
        <h3 class="mt-1 text-xl font-bold">Ready for the 365-Day Capstone Assessment?</h3>
        <p class="mt-1.5 text-sm text-[#f8f3e8]/85">
          Test cumulative mastery across all 12 modules before wrapping up the roadmap.
        </p>
        <a
          href="/final-exam/"
          class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-2.5 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
        >
          Start Final Exam →
        </a>
      </div>
    )}
  </main>
  <Footer />
</Layout>
