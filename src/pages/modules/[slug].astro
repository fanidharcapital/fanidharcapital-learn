---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import ModuleQuiz from "@/components/ModuleQuiz.astro";
import { MODULE_QUIZZES } from "@/data/moduleQuizzes";
import { getSortedPosts } from "@/utils/getSortedPosts";

export async function getStaticPaths() {
  const modules = [
    { slug: "module-01", num: "01", range: "01–30", start: 1, end: 30, title: "Market foundations", detail: "How India’s equity markets work, from shares and indices to order types." },
    { slug: "module-02", num: "02", range: "31–60", start: 31, end: 60, title: "Exchanges & operations", detail: "Trading sessions, clearing, settlement, and the systems behind each trade." },
    { slug: "module-03", num: "03", range: "61–90", start: 61, end: 90, title: "Fundamental analysis", detail: "Understand businesses, financial statements, valuation, and key ratios." },
    { slug: "module-04", num: "04", range: "91–120", start: 91, end: 120, title: "Technical analysis", detail: "Read charts, trends, support and resistance, and common indicators." },
    { slug: "module-05", num: "05", range: "121–150", start: 121, end: 150, title: "Price action", detail: "Build a structured approach to candles, market structure, and context." },
    { slug: "module-06", num: "06", range: "151–180", start: 151, end: 180, title: "Futures market", detail: "Learn contracts, margin, expiry, basis, and futures risk." },
    { slug: "module-07", num: "07", range: "181–210", start: 181, end: 210, title: "Options market", detail: "Explore calls, puts, payoff profiles, and option-chain terminology." },
    { slug: "module-08", num: "08", range: "211–240", start: 211, end: 240, title: "Greeks & strategies", detail: "Understand sensitivity measures and how multi-leg positions behave." },
    { slug: "module-09", num: "09", range: "241–270", start: 241, end: 270, title: "Risk & psychology", detail: "Study position sizing, risk limits, discipline, and decision-making." },
    { slug: "module-10", num: "10", range: "271–300", start: 271, end: 300, title: "Institutions & macro", detail: "Connect economic data, global cues, and institutional activity." },
    { slug: "module-11", num: "11", range: "301–330", start: 301, end: 330, title: "Advanced concepts", detail: "Explore market structure, volatility, and more complex frameworks." },
    { slug: "module-12", num: "12", range: "331–365", start: 331, end: 365, title: "Case studies", detail: "Apply the concepts through educational examples and review exercises." },
  ];

  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(allPosts);

  return modules.map((mod, idx) => {
    const introPost =
      allPosts.find(
        post =>
          post.data.tags?.includes(mod.slug) &&
          post.data.tags?.includes("module-overview")
      ) ?? null;

    const modulePosts = sortedPosts
      .filter(post => {
        if (post.data.tags?.includes("module-overview")) return false;
        const hasTag = post.data.tags?.includes(mod.slug);
        const match = post.data.title.match(/#(\d+)/);
        const lessonNum = match ? Number(match[1]) : null;
        const inRange = lessonNum !== null && lessonNum >= mod.start && lessonNum <= mod.end;
        return hasTag || inRange;
      })
      .sort((a, b) => {
        const numA = Number(a.data.title.match(/#(\d+)/)?.[1] ?? 0);
        const numB = Number(b.data.title.match(/#(\d+)/)?.[1] ?? 0);
        return numA - numB;
      });

    return {
      params: { slug: mod.slug },
      props: {
        mod,
        introPost,
        modulePosts,
        prevMod: idx > 0 ? modules[idx - 1] : null,
        nextMod: idx < modules.length - 1 ? modules[idx + 1] : null,
      },
    };
  });
}

const { mod, introPost, modulePosts, prevMod, nextMod } = Astro.props;
const renderedIntro = introPost ? await render(introPost) : null;
const IntroContent = renderedIntro?.Content ?? null;
const moduleQuiz = MODULE_QUIZZES[mod.slug];
---

<Layout title={`Module ${mod.num}: ${mod.title} (Days ${mod.range}) | Shree Fanidhar Capital`}>
  <Header />

  <section class="border-b-2 border-[#10201a] bg-[#08241b] px-4 py-10 text-[#f8f3e8] sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <a
          href="/curriculum/"
          class="inline-flex min-h-9 items-center rounded-xl border border-[#d8bd7b]/50 bg-[#061c15] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-[#d8bd7b] transition hover:border-[#d8bd7b] hover:bg-white/10"
        >
          ← All Modules
        </a>
        <span class="rounded-full border border-[#52b788]/40 bg-[#1b4332] px-3.5 py-1 font-mono text-xs font-semibold text-[#95d5b2]">
          Days {mod.range}
        </span>
        <span class="rounded-full border border-white/15 bg-white/10 px-3.5 py-1 font-mono text-xs text-[#e5ece7]">
          {modulePosts.length} {modulePosts.length === 1 ? "Lesson" : "Lessons"}
        </span>
      </div>

      <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-[#d8bd7b]">
        MODULE {mod.num} · SHREE FANIDHAR CAPITAL
      </p>
      <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-[#f8f3e8] sm:text-4xl lg:text-5xl">
        {mod.title}
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-[#dce6e0] sm:text-base">
        {mod.detail}
      </p>
    </div>
  </section>

  <main id="main-content" class="module-page mx-auto w-full max-w-6xl bg-[#faf8f3] px-4 py-12 text-[#10201a] sm:px-6 lg:px-8">
    {IntroContent && (
      <section class="mb-12 rounded-2xl border-2 border-[#10201a] bg-white p-6 shadow-[0_4px_0_#10201a] sm:p-10">
        <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#4b5d52]">
          MODULE {mod.num} INTRODUCTORY OVERVIEW
        </p>
        <div class="app-prose prose max-w-none text-[#10201a]">
          <IntroContent />
        </div>
      </section>
    )}

    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b-2 border-[#10201a]/15 pb-6">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#4b5d52]">
          MODULE LESSONS
        </p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight text-[#10201a]">
          {modulePosts.length > 0
            ? `${modulePosts.length} published ${modulePosts.length === 1 ? "lesson" : "lessons"} (Days ${mod.range})`
            : `Upcoming Module (Days ${mod.range})`}
        </h2>
      </div>
      <a
        href="/posts/"
        class="inline-flex min-h-11 items-center rounded-xl border-2 border-[#10201a] bg-white px-4 py-2 text-sm font-semibold text-[#10201a] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5 hover:bg-[#f5f0e4]"
      >
        Browse all lessons ↗
      </a>
    </div>

    {
      modulePosts.length > 0 ? (
        <ul class="grid gap-5 md:grid-cols-2">
          {modulePosts.map(post => <Card variant="h3" {...post} />)}
        </ul>
      ) : (
        <div class="rounded-2xl border-2 border-[#10201a] bg-white p-8 shadow-[0_3px_0_#10201a]">
          <p class="text-lg font-bold text-[#10201a]">Lessons for Module {mod.num} are coming soon</p>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-[#3b4d43]">
            New lessons in the 365-Day Learning Roadmap are added sequentially. Explore the published modules in the meantime.
          </p>
          <a
            href="/curriculum/"
            class="mt-5 inline-flex min-h-11 items-center rounded-xl border-2 border-[#10201a] bg-[#08241b] px-5 py-2.5 text-sm font-semibold text-[#f8f3e8] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5 hover:bg-[#10201a]"
          >
            ← Back to 12 Modules
          </a>
        </div>
      )
    }

    {moduleQuiz && <ModuleQuiz quiz={moduleQuiz} />}

    <nav aria-label="Module navigation" class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t-2 border-[#10201a]/15 pt-8">
      {prevMod ? (
        <a
          href={`/modules/${prevMod.slug}/`}
          class="inline-flex flex-col rounded-xl border-2 border-[#10201a] bg-white px-5 py-3 shadow-[0_3px_0_#10201a] transition hover:-translate-y-0.5"
        >
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#4b5d52]">← Previous Module</span>
          <span class="mt-1 font-bold text-[#10201a]">Module {prevMod.num}: {prevMod.title}</span>
        </a>
      ) : <div />}

      {nextMod && (
        <a
          href={`/modules/${nextMod.slug}/`}
          class="inline-flex flex-col rounded-xl border-2 border-[#10201a] bg-white px-5 py-3 text-right shadow-[0_3px_0_#10201a] transition hover:-translate-y-0.5"
        >
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#4b5d52]">Next Module →</span>
          <span class="mt-1 font-bold text-[#10201a]">Module {nextMod.num}: {nextMod.title}</span>
        </a>
      )}
    </nav>
  </main>

  <Footer />
</Layout>
