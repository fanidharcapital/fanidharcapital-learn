---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SITE from "@/config";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const lessonCount = allPosts.filter(
  post => !(post.data.tags ?? []).includes("module-overview")
).length;
---

<Layout title={SITE.site.title}>
  <Header />
  <main id="main-content" class="bg-[#faf8f3] text-[#10201a]">
    <!-- Top Dark Green Banner -->
    <section class="border-b-2 border-[#10201a] bg-[#08241b] text-[#f8f3e8]">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">
          SHREE FANIDHAR CAPITAL · 365-DAY LEARNING ROADMAP
        </p>
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
          Master the Structure of Today’s Stock Market
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-[#dce6e0] sm:text-base">
          Understand the markets. Navigate complexity. Build disciplined execution—through 12 structured, knowledge-based modules built for Indian equity and derivatives learners.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/curriculum/"
            class="inline-flex min-h-11 items-center rounded-xl border-2 border-[#d8bd7b] bg-[#d8bd7b] px-5 py-3 text-sm font-semibold text-[#08241b] shadow-[0_3px_0_#04120d] transition hover:-translate-y-0.5 hover:opacity-95"
          >
            Explore the Curriculum →
          </a>
          <a
            href="/about/"
            class="inline-flex min-h-11 items-center rounded-xl border border-[#f8f3e8]/30 bg-white/5 px-5 py-3 text-sm font-semibold text-[#f8f3e8] transition hover:bg-white/10"
          >
            About the series
          </a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            365-Day Roadmap
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            12 Structured Modules
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            Visual Infographics
          </span>
        </div>
      </div>

      <!-- Curriculum Live Strip -->
      <div class="border-t border-white/10 bg-[#061c15]">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <span class="rounded-full border border-[#52b788]/40 bg-[#1b4332] px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-[#95d5b2]">
              ● CURRICULUM LIVE
            </span>
            <span class="font-semibold text-[#d8bd7b]">{lessonCount} Lessons Published</span>
            <span class="text-[#c5d3ca]">·</span>
            <span class="text-[#dce6e0]">Start your structured market learning sessions now.</span>
          </div>

          <a
            href="/curriculum/"
            class="inline-flex items-center rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-xs font-semibold text-[#f8f3e8] transition hover:bg-white/20"
          >
            Open Curriculum →
          </a>
        </div>
      </div>
    </section>

    <!-- Visual Roadmap & Curriculum CTA -->
    <section id="curriculum-visual" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="rounded-3xl border-2 border-[#10201a] bg-white p-5 shadow-[0_4px_0_#10201a] sm:p-8 lg:p-10">
        <div class="flex flex-col justify-between gap-4 border-b-2 border-[#10201a]/15 pb-6 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#4b5d52]">
              12-MODULE VISUAL OVERVIEW
            </p>
            <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-[#10201a] sm:text-3xl">
              From market foundations to case studies
            </h2>
          </div>

          <a
            href="/curriculum/"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl border-2 border-[#10201a] bg-[#08241b] px-5 py-3 text-sm font-semibold text-[#f8f3e8] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5 hover:bg-[#10201a]"
          >
            Go to Curriculum →
          </a>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border-2 border-[#10201a] bg-[#faf8f3]">
          <img
            src="/images/lessons/curriculum-overview.png"
            alt="Shree Fanidhar Capital — Master the Structure of Today’s Stock Market: 12-module learning roadmap from Market foundations to Case studies."
            class="block h-auto w-full object-cover"
            loading="eager"
          />
        </div>

        <div class="mt-6 flex flex-col justify-between gap-4 pt-2 sm:flex-row sm:items-center">
          <p class="text-sm leading-6 text-[#3b4d43]">
            Select <strong>Explore the Curriculum</strong> to open any module and study lessons step by step at your own pace.
          </p>
          <a
            href="/curriculum/"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-3 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
          >
            Explore the Curriculum →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
