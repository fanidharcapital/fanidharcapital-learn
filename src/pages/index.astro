---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <div class="my-4 flex items-center gap-3 sm:my-8">
        <h1 class="text-4xl font-bold sm:text-5xl">
          Shree Fanidhar Capital — Learning Series
        </h1>
        <a
          target="_blank"
          href="/rss.xml"
          class="text-sm font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
          aria-label="rss feed"
          title="RSS Feed"
        >
          RSS
        </a>
      </div>

      <p>
        Structured market education notes on Indian equity market structure,
        clearing and T+1 settlement mechanics, volatility regimes, and risk
        governance.
      </p>
      <p class="mt-2">
        Published strictly for educational and training purposes by{" "}
        <a
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://fanidharcapital.com/"
        >
          Shree Fanidhar Capital
        </a>
        . Not SEBI-registered investment advice or a security recommendation.
      </p>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <a
        href="/posts/"
        class="inline-block underline decoration-dashed underline-offset-4 hover:text-accent"
      >
        All Posts &rarr;
      </a>
    </div>
  </main>
  <Footer />
</Layout>
