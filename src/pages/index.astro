---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SITE from "@/config";

interface ModuleCardItem {
  id: string;
  code: string;
  title: string;
  days: string;
  summary: string;
  href: string;
  count: number;
}

const MODULES: Omit<ModuleCardItem, "count">[] = [
  {
    id: "module-01",
    code: "MODULE 01",
    title: "Market foundations",
    days: "Days 01-30",
    summary:
      "Shares, indices, market participants, and order types.",
    href: "/modules/module-01/",
  },
  {
    id: "module-02",
    code: "MODULE 02",
    title: "Exchanges & operations",
    days: "Days 31-60",
    summary:
      "Trading sessions, clearing, settlement, and market infrastructure.",
    href: "/modules/module-02/",
  },
  {
    id: "module-03",
    code: "MODULE 03",
    title: "Fundamental analysis",
    days: "Days 61-90",
    summary:
      "Businesses, financial statements, valuation, and key ratios.",
    href: "/modules/module-03/",
  },
  {
    id: "module-04",
    code: "MODULE 04",
    title: "Technical analysis",
    days: "Days 91-120",
    summary:
      "Charts, trends, support and resistance, and indicators.",
    href: "/modules/module-04/",
  },
  {
    id: "module-05",
    code: "MODULE 05",
    title: "Price action",
    days: "Days 121-150",
    summary:
      "Candles, market structure, and context.",
    href: "/modules/module-05/",
  },
  {
    id: "module-06",
    code: "MODULE 06",
    title: "Futures market",
    days: "Days 151-180",
    summary:
      "Contracts, margin, expiry, basis, and futures risk.",
    href: "/modules/module-06/",
  },
  {
    id: "module-07",
    code: "MODULE 07",
    title: "Options market",
    days: "Days 181-210",
    summary:
      "Calls, puts, payoff profiles, and option-chain terminology.",
    href: "/modules/module-07/",
  },
  {
    id: "module-08",
    code: "MODULE 08",
    title: "Greeks & strategies",
    days: "Days 211-240",
    summary:
      "Sensitivity measures and multi-leg position behaviour.",
    href: "/modules/module-08/",
  },
  {
    id: "module-09",
    code: "MODULE 09",
    title: "Risk & psychology",
    days: "Days 241-270",
    summary:
      "Position sizing, risk limits, discipline, and decision-making.",
    href: "/modules/module-09/",
  },
  {
    id: "module-10",
    code: "MODULE 10",
    title: "Institutions & macro",
    days: "Days 271-300",
    summary:
      "Economic data, global cues, and institutional activity.",
    href: "/modules/module-10/",
  },
  {
    id: "module-11",
    code: "MODULE 11",
    title: "Advanced concepts",
    days: "Days 301-330",
    summary:
      "Market structure, volatility, and advanced frameworks.",
    href: "/modules/module-11/",
  },
  {
    id: "module-12",
    code: "MODULE 12",
    title: "Case studies",
    days: "Days 331-365",
    summary:
      "Educational examples, application, and review exercises.",
    href: "/modules/module-12/",
  },
];

function getLessonNumber(post: any): number {
  const cleanTitle = (post.data.title ?? "")
    .replace(/^(?:Education(?:al)?\s+Series\s*)/i, "")
    .trim();
  const titleMatch = cleanTitle.match(/^#?(\d{1,3})\b/);
  if (titleMatch) return Number(titleMatch[1]);
  const slugMatch =
    post.slug?.match(/(?:day|series)-(\d{1,3})\b/i) ||
    post.id?.match(/(?:day|series)-(\d{1,3})\b/i);
  if (slugMatch) return Number(slugMatch[1]);
  return 9999;
}

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const lessonPosts = allPosts.filter(
  post => !(post.data.tags ?? []).includes("module-overview")
);
const lessonCount = lessonPosts.length;

const moduleCards: ModuleCardItem[] = MODULES.map(mod => {
  const count = lessonPosts.filter(post => {
    const tags = post.data.tags ?? [];
    if (tags.includes(mod.id)) return true;

    const num = getLessonNumber(post);
    const modNum = parseInt(mod.id.replace("module-", ""), 10);

    return num !== 9999 && Math.ceil(num / 30) === modNum;
  }).length;

  return { ...mod, count };
});
---

<Layout title={SITE.site.title}>
  <Header />
  <main id="main-content" class="bg-[#faf8f3] text-[#10201a]">
    <!-- Top Dark Green Banner -->
    <section class="border-b border-[#10201a] bg-[#08241b] text-[#f8f3e8]">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">
          SHREE FANIDHAR CAPITAL · 365-DAY LEARNING ROADMAP
        </p>
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
          Build your market knowledge, one lesson at a time.
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-[#dce6e0] sm:text-base">
          A self-paced roadmap through Indian markets, analysis, derivatives, and risk management—with clear explanations, visual examples, and practical exercises. Lessons are being published progressively.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/posts/"
            class="inline-flex min-h-11 items-center rounded-xl bg-[#d8bd7b] px-5 py-3 text-sm font-semibold text-[#08241b] transition hover:opacity-95"
          >
            Start learning →
          </a>
          <a
            href="/curriculum/"
            class="inline-flex min-h-11 items-center rounded-xl border border-[#f8f3e8]/30 bg-white/5 px-5 py-3 text-sm font-semibold text-[#f8f3e8] transition hover:bg-white/10"
          >
            Explore the curriculum
          </a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            365-Day Roadmap
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            12 Structured Modules
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            Visual Infographics
          </span>
        </div>
      </div>

      <!-- Curriculum Live Strip -->
      <div class="border-t border-white/10 bg-[#061c15]">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <span class="rounded-full border border-[#52b788]/40 bg-[#1b4332] px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-[#95d5b2]">
              ● CURRICULUM LIVE
            </span>
            <span class="font-semibold text-[#d8bd7b]">{lessonCount} Lessons Published</span>
            <span class="text-[#c5d3ca]">·</span>
            <span class="text-[#dce6e0]">Start your structured market learning sessions now.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- The 365-Day Curriculum -->
    <section id="curriculum" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#4b5d52]">
        THE 365-DAY CURRICULUM
      </p>
      <h2 class="mt-1 text-3xl font-bold tracking-tight text-[#10201a]">
        Twelve structured modules
      </h2>
      <p class="mt-2 text-sm text-[#4b5d52]">
        Select any module to browse its lessons and overview.
      </p>

      <ul class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          moduleCards.map(mod => (
            <li>
              <a
                href={mod.href}
                class="group flex h-full flex-col justify-between rounded-2xl border border-[#10201a]/20 bg-white p-6 text-[#10201a] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#10201a] hover:shadow-md"
              >
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#4b5d52]">
                      {mod.code}
                    </span>
                    <span class="font-mono text-xs text-[#4b5d52]">
                      {mod.days} · {mod.count} lessons
                    </span>
                  </div>

                  <h3 class="mt-3 text-xl font-bold tracking-tight text-[#10201a] group-hover:underline">
                    {mod.title}
                  </h3>

                  <p class="mt-2 text-sm leading-6 text-[#3b4d43]">
                    {mod.summary}
                  </p>
                </div>

                <div class="mt-5 text-sm font-semibold text-[#10201a]">
                  Explore module ↗
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
