---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SITE from "@/config";

const chapters = [
  { slug: "module-01", num: "01", title: "Market foundations" },
  { slug: "module-02", num: "02", title: "Exchanges & operations" },
  { slug: "module-03", num: "03", title: "Fundamental analysis" },
  { slug: "module-04", num: "04", title: "Technical analysis" },
  { slug: "module-05", num: "05", title: "Price action" },
  { slug: "module-06", num: "06", title: "Futures market" },
  { slug: "module-07", num: "07", title: "Options market" },
  { slug: "module-08", num: "08", title: "Greeks & strategies" },
  { slug: "module-09", num: "09", title: "Risk & psychology" },
  { slug: "module-10", num: "10", title: "Institutions & macro" },
  { slug: "module-11", num: "11", title: "Advanced concepts" },
  { slug: "module-12", num: "12", title: "Case studies" },
];
---

<Layout title={SITE.site.title}>
  <Header />
  <main id="main-content" class="bg-[#faf8f3] text-[#10201a]">
    <!-- Top Dark Green Banner -->
    <section class="border-b-2 border-[#10201a] bg-[#08241b] text-[#f8f3e8]">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#d8bd7b]">
          SHREE FANIDHAR CAPITAL · 365-DAY LEARNING ROADMAP
        </p>
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
          Master the Structure of Today’s Stock Market
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-[#dce6e0] sm:text-base">
          Understand the markets. Navigate complexity. Build disciplined execution—through 12 structured, knowledge-based modules built for Indian equity and derivatives learners.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/curriculum/"
            class="inline-flex min-h-11 items-center rounded-xl border-2 border-[#d8bd7b] bg-[#d8bd7b] px-5 py-3 text-sm font-semibold text-[#08241b] shadow-[0_3px_0_#04120d] transition hover:-translate-y-0.5 hover:opacity-95"
          >
            Explore the Curriculum →
          </a>
          <a
            href="/about/"
            class="inline-flex min-h-11 items-center rounded-xl border border-[#f8f3e8]/30 bg-white/5 px-5 py-3 text-sm font-semibold text-[#f8f3e8] transition hover:bg-white/10"
          >
            About the series
          </a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            365-Day Roadmap
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            12 Structured Modules
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 font-mono text-xs text-[#e5ece7]">
            Visual Infographics
          </span>
        </div>
      </div>
    </section>

    <!-- Visual Roadmap & Clickable 12 Chapters -->
    <section id="curriculum-visual" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="rounded-3xl border-2 border-[#10201a] bg-white p-5 shadow-[0_4px_0_#10201a] sm:p-8 lg:p-10">
        <div class="border-b-2 border-[#10201a]/15 pb-6">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#4b5d52]">
            12-MODULE VISUAL OVERVIEW
          </p>
          <h2 class="mt-1.5 text-2xl font-bold tracking-tight text-[#10201a] sm:text-3xl">
            From market foundations to case studies
          </h2>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border-2 border-[#10201a] bg-[#faf8f3]">
          <img
            src="/images/lessons/curriculum-overview.png"
            alt="Shree Fanidhar Capital — Master the Structure of Today’s Stock Market: 12-module learning roadmap from Market foundations to Case studies."
            class="block h-auto w-full object-cover"
            loading="eager"
          />
        </div>

        <!-- Clickable 12 Chapters Grid (No Circle Bullets) -->
        <div class="mt-8 border-t-2 border-[#10201a]/15 pt-7">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
            <div>
              <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#4b5d52]">
                365-DAY ROADMAP ✓ QUICK JUMP
              </p>
              <h3 class="mt-1 text-xl font-bold tracking-tight text-[#10201a] sm:text-2xl">
                All 12 Chapters
              </h3>
            </div>
            <p class="text-xs text-[#4b5d52] sm:text-sm">
              Tap any chapter heading to open its module page.
            </p>
          </div>

          <ul class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
            {chapters.map((chapter) => (
              <li class="m-0 p-0">
                <a
                  href={`/modules/${chapter.slug}/`}
                  class="group flex items-center justify-between gap-3 rounded-xl border-2 border-[#10201a] bg-[#faf8f3] px-4 py-3 text-sm font-semibold text-[#10201a] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5 hover:bg-[#08241b] hover:text-[#f8f3e8]"
                >
                  <span class="flex items-center gap-2.5 truncate">
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-md bg-[#08241b] px-2 py-0.5 font-mono text-xs font-bold text-[#d8bd7b] group-hover:bg-[#d8bd7b] group-hover:text-[#08241b]">
                      ✓ {chapter.num}
                    </span>
                    <span class="truncate">{chapter.title}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="shrink-0 font-mono text-xs text-[#4b5d52] transition-transform group-hover:translate-x-0.5 group-hover:text-[#d8bd7b]"
                  >
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 flex flex-col justify-between gap-4 border-t-2 border-[#10201a]/15 pt-6 sm:flex-row sm:items-center">
          <p class="text-sm leading-6 text-[#3b4d43]">
            Select <strong>Explore the Curriculum</strong> to view full module details and study lessons step by step.
          </p>
          <a
            href="/curriculum/"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-3 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
          >
            Explore the Curriculum →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
