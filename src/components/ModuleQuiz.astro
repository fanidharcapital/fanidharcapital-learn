---
import type { ModuleQuizData } from "@/data/moduleQuizzes";

interface Props {
  quiz: ModuleQuizData;
}

const { quiz } = Astro.props;
const quizUrl = `/quizzes/${quiz.moduleSlug}/`;
---

<section
  id="module-quiz-launcher"
  class="mt-10 rounded-3xl border-2 border-[#10201a] bg-[#08241b] p-6 text-[#f8f3e8] shadow-[0_4px_0_#10201a] sm:p-7"
  data-storage-key={`sfc_quiz_${quiz.moduleSlug}`}
  data-passing-score={quiz.passingScore}
  data-total-questions={quiz.questions.length}
>
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#d8bd7b]">
        MODULE CHECKPOINT · {quiz.questions.length} QUESTIONS · PASS {quiz.passingScore}/{quiz.questions.length}
      </p>
      <h2 class="mt-1 text-xl font-bold text-white sm:text-2xl">
        {quiz.moduleTitle} Quiz
      </h2>
      <p class="mt-1 text-sm text-[#f8f3e8]/80">
        Opens in a new window so you can take the checkpoint cleanly without losing your place in the chapter.
      </p>
    </div>

    <span
      id="launcher-score-badge"
      class="hidden self-start rounded-full border-2 border-[#d8bd7b]/60 bg-[#10201a] px-3.5 py-1.5 font-mono text-xs font-semibold text-[#d8bd7b] sm:self-auto"
    ></span>
  </div>

  <div class="mt-5">
    <a
      href={quizUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-2.5 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
    >
      Open Quiz in New Window ↗
    </a>
  </div>
</section>

<script>
  function syncLauncherBadge() {
    const box = document.getElementById("module-quiz-launcher");
    const badge = document.getElementById("launcher-score-badge");
    if (!box || !badge) return;

    const key = box.getAttribute("data-storage-key");
    const passScore = Number(box.getAttribute("data-passing-score") ?? 2);
    const total = Number(box.getAttribute("data-total-questions") ?? 3);
    if (!key) return;

    const saved = localStorage.getItem(key);
    if (saved !== null) {
      const score = Number(saved);
      badge.textContent = `${score >= passScore ? "✓ Passed" : "Best"}: ${score} / ${total}`;
      badge.classList.remove("hidden");
    }
  }

  syncLauncherBadge();
  document.addEventListener("astro:after-swap", syncLauncherBadge);
</script>
