---
import type { ModuleQuizData } from "@/data/moduleQuizzes";

interface Props {
  quiz: ModuleQuizData;
}

const { quiz } = Astro.props;
const quizJson = JSON.stringify(quiz);
---

<section
  id="module-quiz"
  class="mt-12 rounded-3xl border-2 border-[#10201a] bg-white p-5 shadow-[0_4px_0_#10201a] sm:p-8"
  data-quiz={quizJson}
>
  <div class="flex flex-col justify-between gap-3 border-b-2 border-[#10201a]/15 pb-5 sm:flex-row sm:items-center">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#9c7016]">
        MODULE CHECKPOINT · 5 QUESTIONS
      </p>
      <h2 class="mt-1 text-xl font-bold tracking-tight text-[#10201a] sm:text-2xl">
        Test Your Understanding: {quiz.moduleTitle}
      </h2>
    </div>
    <span
      id="quiz-saved-badge"
      class="hidden self-start rounded-full border-2 border-[#10201a] bg-[#08241b] px-3 py-1 font-mono text-xs font-semibold text-[#d8bd7b] sm:self-auto"
    >
      Saved Score: 0 / 5
    </span>
  </div>

  <form id="module-quiz-form" class="mt-6 space-y-6">
    {quiz.questions.map((q, qIdx) => (
      <fieldset
        class="quiz-question-card rounded-2xl border-2 border-[#10201a] bg-[#faf8f3] p-4 sm:p-5"
        data-question-index={qIdx}
      >
        <legend class="px-1 font-mono text-xs font-bold uppercase tracking-wider text-[#4b5d52]">
          Question {qIdx + 1} of {quiz.questions.length}
        </legend>
        <p class="mt-1 text-base font-bold leading-snug text-[#10201a]">
          {q.question}
        </p>

        <div class="mt-3.5 space-y-2.5">
          {q.options.map((opt, optIdx) => (
            <label class="quiz-option flex cursor-pointer items-start gap-3 rounded-xl border-2 border-[#10201a]/25 bg-white px-3.5 py-2.5 text-sm font-medium text-[#10201a] transition hover:border-[#10201a]">
              <input
                type="radio"
                name={`q-${qIdx}`}
                value={optIdx}
                class="mt-0.5 size-4 shrink-0 accent-[#08241b]"
              />
              <span>{opt}</span>
            </label>
          ))}
        </div>

        <p class="quiz-explanation mt-3 hidden rounded-xl border border-[#10201a]/20 bg-white px-3.5 py-2.5 text-xs leading-5 text-[#2d3e35]"></p>
      </fieldset>
    ))}

    <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#10201a] bg-[#d8bd7b] px-6 py-3 text-sm font-semibold text-[#08241b] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
        >
          Submit Answers
        </button>
        <button
          type="button"
          id="quiz-reset-btn"
          class="hidden min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#10201a] bg-white px-5 py-3 text-sm font-semibold text-[#10201a] transition hover:bg-[#faf8f3]"
        >
          Retake Quiz
        </button>
      </div>

      <div
        id="quiz-result-box"
        class="hidden rounded-xl border-2 border-[#10201a] bg-[#08241b] px-4 py-2.5 text-sm font-semibold text-[#f8f3e8]"
        aria-live="polite"
      ></div>
    </div>
  </form>
</section>

<script>
  function initModuleQuiz() {
    const section = document.getElementById("module-quiz");
    if (!section) return;

    const rawData = section.getAttribute("data-quiz");
    if (!rawData) return;

    const quiz = JSON.parse(rawData);
    const storageKey = `sfc_quiz_${quiz.moduleSlug}`;
    const form = document.getElementById("module-quiz-form") as HTMLFormElement | null;
    const resetBtn = document.getElementById("quiz-reset-btn");
    const resultBox = document.getElementById("quiz-result-box");
    const savedBadge = document.getElementById("quiz-saved-badge");

    if (!form || !resetBtn || !resultBox || !savedBadge) return;

    const updateBadge = (score: number) => {
      const passed = score >= quiz.passingScore;
      savedBadge.textContent = `${passed ? "✓ Passed" : "Best Score"}: ${score} / ${quiz.questions.length}`;
      savedBadge.classList.remove("hidden");
    };

    const existing = localStorage.getItem(storageKey);
    if (existing !== null) {
      updateBadge(Number(existing));
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      let score = 0;

      quiz.questions.forEach((q: any, qIdx: number) => {
        const card = form.querySelector(`[data-question-index="${qIdx}"]`);
        if (!card) return;

        const selected = form.querySelector(`input[name="q-${qIdx}"]:checked`) as HTMLInputElement | null;
        const chosenIdx = selected ? Number(selected.value) : -1;
        const optionLabels = card.querySelectorAll(".quiz-option");
        const explanationEl = card.querySelector(".quiz-explanation");

        optionLabels.forEach((label, optIdx) => {
          label.classList.remove("border-emerald-700", "bg-emerald-50", "border-red-700", "bg-red-50");
          if (optIdx === q.correctIndex) {
            label.classList.add("border-emerald-700", "bg-emerald-50");
          } else if (optIdx === chosenIdx && chosenIdx !== q.correctIndex) {
            label.classList.add("border-red-700", "bg-red-50");
          }
        });

        if (chosenIdx === q.correctIndex) {
          score += 1;
        }

        if (explanationEl) {
          explanationEl.textContent = `${chosenIdx === q.correctIndex ? "Correct:" : "Explanation:"} ${q.explanation}`;
          explanationEl.classList.remove("hidden");
        }
      });

      const passed = score >= quiz.passingScore;
      resultBox.textContent = passed
        ? `Score: ${score} / ${quiz.questions.length} — Module Checkpoint Cleared!`
        : `Score: ${score} / ${quiz.questions.length} — Need ${quiz.passingScore}/${quiz.questions.length} to pass. Review explanations above and retry.`;
      resultBox.classList.remove("hidden");
      resetBtn.classList.remove("hidden");

      const prevBest = Number(localStorage.getItem(storageKey) ?? -1);
      if (score > prevBest) {
        localStorage.setItem(storageKey, String(score));
      }
      updateBadge(Math.max(score, prevBest));
    });

    resetBtn.addEventListener("click", () => {
      form.reset();
      resultBox.classList.add("hidden");
      resetBtn.classList.add("hidden");
      form.querySelectorAll(".quiz-option").forEach((label) => {
        label.classList.remove("border-emerald-700", "bg-emerald-50", "border-red-700", "bg-red-50");
      });
      form.querySelectorAll(".quiz-explanation").forEach((el) => {
        el.classList.add("hidden");
      });
    });
  }

  initModuleQuiz();
  document.addEventListener("astro:after-swap", initModuleQuiz);
</script>
