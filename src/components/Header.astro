---
import { getCollection } from "astro:content";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const publishedLessonCount = allPosts.filter(
  post => !(post.data.tags ?? []).includes("module-overview")
).length;
---

<header
  id="main-header"
  class="border-b border-border/70 bg-background/95 shadow-[0_1px_0_rgba(12,48,36,0.02)]"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4">
      <a
        href="/"
        class="group flex min-w-0 flex-col leading-tight"
        aria-label="Shree Fanidhar Capital Educational Series home"
      >
        <span class="text-[0.68rem] font-semibold uppercase tracking-[0.19em] text-accent sm:text-xs">
          Shree Fanidhar Capital
        </span>
        <span class="mt-1 text-lg font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent sm:text-xl">
          Educational Series
        </span>
      </a>
      <span class="hidden rounded-full border border-[#c9a45a]/40 bg-[#f5f0e4] px-3 py-1.5 text-[0.68rem] font-medium tracking-wide text-[#755822] dark:bg-[#203328] dark:text-[#e0c783] sm:inline-flex">
        Learn at your own pace
      </span>
    </div>

    <nav
      id="nav-menu"
      aria-label="Primary"
      class="flex flex-wrap items-center justify-between gap-2 border-t border-border/50 pt-2.5 text-sm"
    >
      <!-- Published Lessons Ticker -->
      <a
        href="/curriculum/"
        class="group inline-flex items-center gap-2 rounded-full border-2 border-[#10201a] bg-[#08241b] px-3 py-1 text-xs font-semibold text-[#f8f3e8] shadow-[0_2px_0_#10201a] transition hover:-translate-y-0.5"
        aria-label={`${publishedLessonCount} of 365 lessons published — view curriculum`}
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#52b788] opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-[#52b788]"></span>
        </span>
        <span class="font-mono tracking-wide text-[#d8bd7b]">
          {publishedLessonCount} / 365
        </span>
        <span class="text-[#e5ece7]">Lessons Published</span>
        <span aria-hidden="true" class="text-[#d8bd7b] transition-transform group-hover:translate-x-0.5">→</span>
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <LinkButton href="/archives/" class:list={["nav-straight-link focus-outline rounded-lg p-1.5 hover:bg-muted hover:text-accent", { "nav-active": isActive("/archives") }]} aria-label="archives" title="Archives">
          <IconArchive class="inline-block size-5" />
          <span class="sr-only">Archives</span>
        </LinkButton>
        <LinkButton href="/search/" class:list={["nav-straight-link focus-outline rounded-lg p-1.5 hover:bg-muted hover:text-accent", { "nav-active": isActive("/search") }]} aria-label="search" title="Search">
          <IconSearch class="inline-block size-5" />
          <span class="sr-only">Search</span>
        </LinkButton>
        <button id="theme-btn" class="focus-outline relative size-8 rounded-lg p-1.5 hover:bg-muted hover:text-accent" title="Toggles light & dark" aria-label="auto" aria-live="polite">
          <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
        <button id="menu-btn" class="focus-outline rounded-lg p-1.5 hover:bg-muted hover:text-accent" aria-label="Open Menu" aria-expanded="false" aria-controls="menu-items">
          <IconX id="close-icon" class="hidden size-5" />
          <IconMenuDeep id="menu-icon" class="size-5" />
        </button>
      </div>

      <ul id="menu-items" class="hidden w-full flex-col gap-2 border-t border-border/40 pt-2.5 pb-1 font-medium">
        <li><a href="/curriculum/" class="block py-1 hover:text-accent">Curriculum</a></li>
        <li><a href="/tags/" class="block py-1 hover:text-accent">Browse by Tags</a></li>
        <li><a href="/archives/" class="block py-1 hover:text-accent">Archives</a></li>
        <li><a href="/search/" class="block py-1 hover:text-accent">Search</a></li>
        <li><a href="/about/" class="block py-1 hover:text-accent">About</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-straight-link {
    text-decoration-style: solid !important;
    text-decoration-line: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .nav-active {
    text-decoration-line: underline !important;
    text-decoration-style: solid !important;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
</style>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");
      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
