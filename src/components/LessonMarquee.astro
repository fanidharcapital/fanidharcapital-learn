---
import { getCollection } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const lessons = posts
  .map(post => {
    const match =
      post.data.title.match(/#(\d+)/) || post.id.match(/day-(\d+)/i);
    const num = match ? parseInt(match[1], 10) : 999;
    const number =
      num !== 999 ? String(num).padStart(2, "0") : "—";
    const cleanTitle = post.data.title.replace(
      /^Education Series #\d+:\s*/i,
      ""
    );

    return {
      num,
      number,
      title: cleanTitle,
      url: getPostUrl(post.id, post.filePath, Astro.currentLocale),
    };
  })
  .sort((a, b) => a.num - b.num);

// 4 seconds per lesson card (e.g., 20 lessons = 80s) so speed stays consistent as you add more lessons
const scrollDuration = Math.max(40, lessons.length * 4);
---

{
  lessons.length > 0 && (
    <section
      aria-label="Education Series Lessons"
      class="w-full overflow-hidden border-b border-[#c9a45a]/30 bg-background py-4"
    >
      <div
        class="marquee-wrapper flex w-max"
        style={`--scroll-duration: ${scrollDuration}s;`}
      >
        {/* Track 1 */}
        <div class="marquee-track flex shrink-0 items-center gap-4 px-2">
          {lessons.map(lesson => (
            <a
              href={lesson.url}
              class="group flex items-center gap-3 whitespace-nowrap rounded-xl border border-[#c9a45a] bg-[#0c3024] px-4 py-2.5 text-[#f8f3e8] shadow-sm transition hover:-translate-y-0.5 hover:border-[#e6c885] hover:bg-[#123d2f]"
            >
              <span class="rounded-md border border-[#c9a45a]/60 bg-[#144233] px-2 py-0.5 text-[11px] font-bold tracking-wider text-[#e6c885]">
                #{lesson.number}
              </span>
              <span class="text-xs font-semibold tracking-wide text-[#f8f3e8] group-hover:text-[#e6c885] sm:text-sm">
                {lesson.title}
              </span>
            </a>
          ))}
        </div>

        {/* Track 2 (seamless duplicate loop) */}
        <div
          aria-hidden="true"
          class="marquee-track flex shrink-0 items-center gap-4 px-2"
        >
          {lessons.map(lesson => (
            <a
              href={lesson.url}
              tabindex="-1"
              class="group flex items-center gap-3 whitespace-nowrap rounded-xl border border-[#c9a45a] bg-[#0c3024] px-4 py-2.5 text-[#f8f3e8] shadow-sm transition hover:-translate-y-0.5 hover:border-[#e6c885] hover:bg-[#123d2f]"
            >
              <span class="rounded-md border border-[#c9a45a]/60 bg-[#144233] px-2 py-0.5 text-[11px] font-bold tracking-wider text-[#e6c885]">
                #{lesson.number}
              </span>
              <span class="text-xs font-semibold tracking-wide text-[#f8f3e8] group-hover:text-[#e6c885] sm:text-sm">
                {lesson.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .marquee-track {
    will-change: transform;
    animation: lesson-scroll var(--scroll-duration, 80s) linear infinite;
  }

  .marquee-wrapper:hover .marquee-track,
  .marquee-wrapper:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes lesson-scroll {
    0% {
      transform: translate3d(0%, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
