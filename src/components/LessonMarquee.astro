---
import { getCollection } from "astro:content";

interface Props {
  seriesUrl?: string;
}

// Change "/posts" below if your Learning Series tab uses a different route (e.g. "/lessons" or "/series")
const { seriesUrl = "/posts" } = Astro.props;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalLessons = posts.length;
---

{
  totalLessons > 0 && (
    <section
      aria-label="Learning Series Announcement"
      class="w-full border-b border-[#c9a45a]/40 bg-[#0c3024] px-4 py-3 text-[#f8f3e8]"
    >
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2.5 sm:flex-row">
        {/* Left: Pulsing Live Badge + Dynamic Lesson Count */}
        <div class="flex flex-wrap items-center justify-center gap-2.5 text-center sm:justify-start sm:text-left">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[#c9a45a]/70 bg-[#144233] px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-[#e6c885]">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#e6c885] opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#e6c885]" />
            </span>
            Curriculum Live
          </span>

          <p class="text-xs font-medium tracking-wide text-[#f8f3e8] sm:text-sm">
            <strong class="font-bold text-[#e6c885]">
              {totalLessons} {totalLessons === 1 ? "Lesson" : "Lessons"} Published
            </strong>
            <span class="mx-1.5 text-[#c9a45a]/60">•</span>
            Start your structured market learning sessions now.
          </p>
        </div>

        {/* Right: Direct CTA Button to Learning Series Tab */}
        <a
          href={seriesUrl}
          class="group inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-[#c9a45a] bg-[#144233] px-3.5 py-1.5 text-xs font-bold tracking-wide text-[#e6c885] shadow-sm transition hover:border-[#e6c885] hover:bg-[#e6c885] hover:text-[#0c3024]"
        >
          <span>Go to Learning Series</span>
          <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          >
            →
          </span>
        </a>
      </div>
    </section>
  )
}
