---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border flex items-center justify-center border-t py-5 text-center text-sm text-muted-foreground">
    <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span aria-hidden="true">|</span>
      <span>{t.footer.allRightsReserved}</span>
      <span aria-hidden="true">|</span>
      <a
        href="https://fanidharcapital.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-accent underline-offset-4 transition hover:text-[#7c5d22] hover:underline"
      >
        fanidharcapital.com
      </a>
    </p>
  </div>
</footer>
