---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";

export interface Props extends CollectionEntry<"posts"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id } = Astro.props;

const { title, description, tags = [] } = data;

const cleanTitle = title.replace(/^(?:Education(?:al)?\s+Series\s*)/i, "").trim();
const postSlug = id.replace(/\.[^/.]+$/, "");
const moduleTag = tags.find(t => /^module-\d{2}$/.test(t));
const href =
  tags.includes("module-overview") && moduleTag
    ? `/modules/${moduleTag}/`
    : `/posts/${postSlug}/`;

const headerProps = {
  style: { viewTransitionName: slugifyStr(cleanTitle) },
  class:
    "text-lg font-bold leading-snug text-[#10201a] transition group-hover:text-[#0c3024] hover:underline",
};
---

<li class="group flex flex-col justify-between rounded-2xl border border-[#10201a]/20 bg-white p-6 text-[#10201a] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#10201a] hover:shadow-md">
  <div>
    {tags.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-2">
        {tags.slice(0, 3).map((tag, idx) => (
          <span
            class:list={[
              "rounded-full px-3 py-1 font-mono text-xs font-medium",
              idx === 0
                ? "bg-[#10201a] text-white"
                : "border border-[#10201a]/15 bg-[#f4f5f4] text-[#23382d]",
            ]}
          >
            #{tag}
          </span>
        ))}
      </div>
    )}

    <a
      href={href}
      class="block rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#10201a]"
    >
      {
        variant === "h2" ? (
          <h2 {...headerProps}>{cleanTitle}</h2>
        ) : (
          <h3 {...headerProps}>{cleanTitle}</h3>
        )
      }
    </a>

    {description && (
      <p class="mt-3 line-clamp-2 text-sm leading-6 text-[#3b4d43]">
        {description}
      </p>
    )}
  </div>
</li>
