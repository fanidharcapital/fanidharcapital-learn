---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"posts"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, tags = [] } = data;

const cleanTitle = title.replace(/^(?:Education(?:al)?\s+Series\s*)/i, "").trim();
const postSlug = id.replace(/\.[^/.]+$/, "");
const moduleTag = tags.find(t => /^module-\d{2}$/.test(t));
const href =
  tags.includes("module-overview") && moduleTag
    ? `/modules/${moduleTag}/`
    : `/posts/${postSlug}/`;

const headerProps = {
  style: { viewTransitionName: slugifyStr(cleanTitle) },
  class: "text-lg font-semibold leading-snug text-white hover:underline",
};
---

<li class="flex flex-col justify-between rounded-2xl border border-[#1a4734] bg-[#0B3524] p-6 text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#c9a45a] hover:shadow-md">
  <div>
    {tags.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-2">
        {tags.slice(0, 3).map(tag => (
          <span class="rounded-full border border-white/15 bg-white/15 px-3 py-1 font-mono text-xs font-medium text-white">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <a
      href={href}
      class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d8bd7b]"
    >
      {
        variant === "h2" ? (
          <h2 {...headerProps}>{cleanTitle}</h2>
        ) : (
          <h3 {...headerProps}>{cleanTitle}</h3>
        )
      }
    </a>

    <div class="mt-2 text-xs text-[#e7d39d] [&_*]:!text-[#e7d39d]">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
    </div>

    {description && (
      <p class="mt-3 line-clamp-2 text-sm leading-6 text-white/90">
        {description}
      </p>
    )}
  </div>
</li>
